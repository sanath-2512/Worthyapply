# At least one provider is required. Requests are routed through a health-aware
# provider router (see backend/llm_router/) that fails fast on a bad/slow provider,
# tracks per-provider health with a circuit breaker, and falls back automatically.
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
MISTRAL_API_KEY=your_mistral_key_here
COHERE_API_KEY=your_cohere_key_here

# ---------------------------------------------------------------------------
# LLM router tuning (all optional; sensible defaults shown).
# Per-provider hard wall-clock timeout in seconds (a hung provider is abandoned
# and the next healthy provider is tried — this is what prevents multi-minute
# hangs). Higher than a chat default because responses are large structured JSON.
# LLM_GROQ_TIMEOUT=20
# LLM_GEMINI_TIMEOUT=25
# LLM_OPENROUTER_TIMEOUT=30
# LLM_MISTRAL_TIMEOUT=25
# LLM_COHERE_TIMEOUT=25

# Provider priority (lower = preferred). Selection = priority + latency + recent failures.
# LLM_GROQ_PRIORITY=1
# LLM_GEMINI_PRIORITY=2
# LLM_OPENROUTER_PRIORITY=3
# LLM_MISTRAL_PRIORITY=4
# LLM_COHERE_PRIORITY=5

# Circuit breaker: open a provider after N consecutive failures, skip it for the
# cooldown, then allow one recovery trial (HALF_OPEN).
# LLM_CIRCUIT_FAILURE_THRESHOLD=3
# LLM_CIRCUIT_COOLDOWN_SECONDS=60

# Error-specific cooldowns (seconds) applied when a provider fails.
# LLM_COOLDOWN_TIMEOUT=20
# LLM_COOLDOWN_RATE_LIMIT=60
# LLM_COOLDOWN_SERVER_ERROR=20
# LLM_COOLDOWN_AUTH=900
# LLM_COOLDOWN_VALIDATION=15
# LLM_COOLDOWN_UNKNOWN=20

# Set to false to try only the single best provider (no fallback).
# LLM_ENABLE_FALLBACK=true
